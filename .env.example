# Copy this file to .env and fill in your values.
# Without OPENAI_API_KEY the swarm runs in offline template mode (no API calls).

OPENAI_API_KEY=your_api_key_here

# Model / generation
MODEL_NAME=gpt-4o-mini
TEMPERATURE=0.7
MAX_TOKENS=2000

# Optional: any OpenAI-compatible endpoint (read natively by the OpenAI SDK)
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Runtime
REQUEST_TIMEOUT=60
MAX_RETRIES=2
MAX_WORKERS=4
DEBUG_MODE=true
LOG_LEVEL=INFO
