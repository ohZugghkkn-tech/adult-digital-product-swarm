# Copy this file to .env and fill in what you need.
# Nothing here is required: with no configuration the swarm runs in handoff mode
# (prompts become task cards, see AGENTS.md) and needs no network at all.

# ------------------------------------------------------------------ providers
# auto | openai | local | handoff | template
SWARM_PROVIDER=auto

# Where runs are stored (prompts, answers, reports). Relative to the repo root.
RUNS_DIR=runs

# ------------------------------------------------- OpenAI / compatible APIs
# Any OpenAI-compatible endpoint works (OpenAI, OpenRouter, Groq, vLLM, Azure...)
OPENAI_API_KEY=
OPENAI_BASE_URL=
MODEL_NAME=gpt-4o-mini

# ------------------------------------------------- local model server (no key)
# Ollama:   http://127.0.0.1:11434/v1   (LOCAL_MODEL=llama3.1)
# LM Studio:http://127.0.0.1:1234/v1
# llama.cpp:http://127.0.0.1:8080/v1
LOCAL_BASE_URL=
LOCAL_API_KEY=
LOCAL_MODEL=

# ------------------------------------------------------------------ generation
TEMPERATURE=0.7
MAX_TOKENS=2000

# -------------------------------------------------------------------- runtime
REQUEST_TIMEOUT=60
MAX_RETRIES=2
MAX_WORKERS=4
DEBUG_MODE=true
LOG_LEVEL=INFO
