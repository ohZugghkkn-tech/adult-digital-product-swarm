import streamlit as st
from orchestrator import SwarmOrchestrator

st.set_page_config(page_title="Adult Digital Product Swarm", layout="wide")
st.title("🏢 Adult Digital Product Swarm")
st.caption("Hierarchical AI swarm with CEO leadership + QA review before final delivery")

with st.form("swarm_form"):
    brief = st.text_area(
        "Business brief",
        value="Create a premium digital product business focused on adult digital learning products and conversion-driven offers.",
        height=160,
    )
    audience = st.text_input("Target audience", value="Adults interested in premium digital products")
    brand_name = st.text_input("Brand name", value="Premium Digital Studio")
    vibe = st.text_input("Brand vibe", value="premium, confident, modern")
    submitted = st.form_submit_button("Run swarm")

if submitted:
    orchestrator = SwarmOrchestrator()
    output = orchestrator.run(brief, audience, brand_name, vibe)

    tabs = st.tabs(["Strategy", "QA Review", "Final Decision"])
    with tabs[0]:
        st.json(output["strategy"])
    with tabs[1]:
        st.write(output["qa_review"])
    with tabs[2]:
        st.write(output["final_decision"])
